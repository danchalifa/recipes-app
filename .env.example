# Copy to .env.local for local development, and set the same names as
# Environment Variables in the Vercel project for production.
# .env and .env.local are gitignored -- never commit real values.

# The single shared admin password. Use a long passphrase: there is no account
# lockout, because serverless instances share no memory to count attempts in.
ADMIN_PASSWORD=

# Signing key for the admin session cookie. Any long random string.
# Changing it immediately invalidates every existing session.
#   openssl rand -hex 32
ADMIN_SECRET=

# Fine-grained personal access token, scoped to this repository only,
# with Contents: Read and write. Nothing else.
GITHUB_TOKEN=

# owner/repo that holds data/recipes.json.
GITHUB_REPO=danchalifa/recipes-app

# Branch Vercel deploys from. A commit here triggers the redeploy.
GITHUB_BRANCH=master

# Dev only: point the GitHub client at a local stub instead of the real API.
# Leave unset in production.
# GITHUB_API_URL=http://localhost:4010
